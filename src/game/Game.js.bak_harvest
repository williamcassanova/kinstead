import * as THREE from "three";
import { AssetManager } from "./AssetManager.js";
import { WorldBuilder } from "./WorldBuilder.js";
import { CameraController } from "./CameraController.js";
import { CharacterAnimation } from "./CharacterAnimation.js";
import { CharacterController } from "./CharacterController.js";
import { ThumbnailRenderer } from "./ThumbnailRenderer.js";
import { NPCManager } from "./NPCManager.js";
import { UIManager } from "../ui/UIManager.js";
import { PLAZA_WORLD } from "./WorldLayout.js";
import { QuestManager } from "./QuestManager.js";
import { InteractionManager } from "./InteractionManager.js";
import { InventoryManager } from "./InventoryManager.js";
import { ItemPickupManager } from "./ItemPickupManager.js";
import { EconomyManager } from "./EconomyManager.js";
import { EquipmentManager } from "./EquipmentManager.js";
import { ResourceManager } from "./ResourceManager.js";
import { RegionWorld, SETTLEMENTS } from "./WorldRegions.js";

export class Game {
  constructor(canvas) {
    this.canvas = canvas;
    this.ui = new UIManager();
    this.settings = this.ui.getSettings();

    this.state = "loading";
    this.stateBeforeAtlas = "menu";
    this.assets = null;
    this.world = null;
    this.player = null;
    this.characters = [];
    this.thumbnails = {};
    this.atlasData = null;
    this.atlasQueue = null;
    this.keys = new Set();
    this.jumpQueued = false;
    this.playTime = 0;
    this.elapsed = 0;
    this.fps = 60;
    this._fpsAccum = 0;
    this._fpsFrames = 0;
    this._clock = new THREE.Clock();
    this._returnToMenu = false;
    this._renderPaused = false;
    this.modeManager = null;
    this.worldDataManager = null;
    this.strategyUIManager = null;

    this.scene = new THREE.Scene();
    this.camera = new THREE.PerspectiveCamera(
      60,
      window.innerWidth / window.innerHeight,
      0.12,
      2000
    );
    this.camera.position.set(40, 34, 90);

    this.renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: false,
      powerPreference: "high-performance",
    });
    this.renderer.outputColorSpace = THREE.SRGBColorSpace;
    this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
    this.renderer.toneMappingExposure = 1.05;
    this.renderer.shadowMap.enabled = true;
    this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    this.renderer.setSize(window.innerWidth, window.innerHeight);

    this.ui.setKeys(this.keys);
    this._bindUI();
    this._bindWindow();
    this._applyRendererQuality(this.settings.quality);
  }

  async start() {
    try {
      this.ui.showLoading();
      this.ui.setLoading(0.02, "Membaca manifes Kinstead");
      await nextFrame();

      this.assets = new AssetManager();
      await this.assets.load(
        (done, total, label) => {
          this.ui.setLoading(
            0.04 + (done / Math.max(1, total)) * 0.42,
            `Memuat ${label || "aset"} (${done}/${total})`
          );
        },
        { buildingIds: null }
      );

      if (this.assets.failures && this.assets.failures.length) {
        console.warn("[Kinstead] Beberapa aset gagal dimuat:", this.assets.failures);
        this.ui.toast(`Beberapa aset gagal dimuat (${this.assets.failures.length})`);
      }

      this.ui.setLoading(0.5, "Menumbuhkan desa dan wilayah sekitarnya");
      await nextFrame();

    this.world = new WorldBuilder({
      scene: this.scene,
      assets: this.assets,
      renderer: this.renderer,
      settings: this.settings,
    });
    const worldInfo = await this.world.build();
    this.world.setCamera(this.camera);

    this.npcManager = new NPCManager({
      scene: this.scene,
      assets: this.assets,
      collision: worldInfo.collision,
      heightfield: worldInfo.heightfield,
      worldBuilder: this.world,
    });
    this.npcManager.initNPCs();

    this.questManager = new QuestManager({
      npcManager: this.npcManager,
      ui: this.ui,
      toast: (msg) => this.ui.toast(msg)
    });

    this.inventoryManager = new InventoryManager({
      ui: this.ui,
      toast: (msg) => this.ui.toast(msg)
    });
    this.questManager.setInventoryManager?.(this.inventoryManager);

    this.economyManager = new EconomyManager({
      inventoryManager: this.inventoryManager,
      ui: this.ui,
      toast: (msg) => this.ui.toast(msg)
    });
    this.ui.setMoney?.(this.economyManager.getMoney());

    // Add tools to inventory definitions (also ensure in manager)
    if (this.inventoryManager) {
      if (!this.inventoryManager.itemDefinitions["kapak"]) {
        this.inventoryManager.itemDefinitions["kapak"] = {
          id: "kapak", name: "Kapak", category: "peralatan", icon: "🪓", description: "Kapak untuk menebang pohon.", stackable: false, maxStack: 1, usable: false, equipable: true, toolType: "axe", questItem: false
        };
      }
      if (!this.inventoryManager.itemDefinitions["beliung"]) {
        this.inventoryManager.itemDefinitions["beliung"] = {
          id: "beliung", name: "Beliung", category: "peralatan", icon: "⛏️", description: "Beliung untuk menambang batu.", stackable: false, maxStack: 1, usable: false, equipable: true, toolType: "pickaxe", questItem: false
        };
      }
      if (!this.inventoryManager.itemDefinitions["pedang"]) {
        this.inventoryManager.itemDefinitions["pedang"] = {
          id: "pedang", name: "Pedang", category: "peralatan", icon: "⚔️", description: "Pedang untuk pertarungan.", stackable: false, maxStack: 1, usable: false, equipable: true, toolType: "sword", questItem: false
        };
      }
      if (!this.inventoryManager.itemDefinitions["kayu"]) {
        this.inventoryManager.itemDefinitions["kayu"] = {
          id: "kayu", name: "Kayu", category: "bahan_alam", icon: "🪵", description: "Kayu hasil tebangan.", stackable: true, maxStack: 99, usable: false, questItem: false
        };
      }
    }

    this.world.onAreaChange = (name) => {
      this.ui.setRegion(name);
      if (name !== "Kinstead") this.ui.toast(`Memasuki ${name}`);
    };
    this.ui.setRegion(this.world.getRegionName());

    this.cameraController = new CameraController({
      camera: this.camera,
      domElement: this.canvas,
      collision: worldInfo.collision,
      settings: this.settings,
    });
    this.cameraController.setSensitivity(this.settings.sensitivity);
    this.cameraController.setInvertY(this.settings.invertY);

    this.thumbnailer = new ThumbnailRenderer(this.assets);
    await this._prepareCharacters();

    if (this.ui.el.menuStatus) {
      this.ui.el.menuStatus.textContent =
        `${this.assets.getBuildingIds().length} bangunan · ` +
        `${this.characters.length} penduduk · ` +
        `${this.assets.getCollectionEntries("animals").length} spesies hewan · ` +
        `wilayah 5,7 km`;
    }

    this.ui.setLoading(1, "Selamat datang di Kinstead");
    await nextFrame();
    this.ui.hideLoading();
    this.ui.showMenu();
    this.state = "menu";
    this._positionCinematic(0);

    this._clock.start();
    this._loop();
    } catch (error) {
      console.error("[Kinstead] startup failed", error);
      const label = document.getElementById("loading-label");
      const tip = document.getElementById("loading-tip");
      if (label) label.textContent = "Gagal memuat Kinstead";
      if (tip) {
        tip.textContent =
          "Pastikan dijalankan lewat HTTP server (python3 -m http.server). " +
          String(error?.message || error);
      }
      throw error;
    }
  }

  // ------------------------------------------------------------------- setup
  async _prepareCharacters() {
    this.characters = this.assets.getCollectionEntries("villagers");
    if (!this.characters.length) {
      throw new Error("No villagers were loaded");
    }

    const recommended = this.assets.manifest?.recommendedCharacters || [];
    const preferred =
      this.characters.find((c) => c.id === this.settings.character) ||
      this.characters.find((c) => c.id === recommended[0]) ||
      this.characters.find((c) => c.id === "villager-farmer-1007") ||
      this.characters[0];
    this.ui.selectedId = preferred.id;
    this.ui.characters = this.characters;

    for (let i = 0; i < this.characters.length; i++) {
      const entry = this.characters[i];
      this.thumbnails[entry.id] = this.thumbnailer.character(
        entry.node,
        entry.id,
        { width: 240, height: 300 }
      );
      const pct = 0.62 + (i / this.characters.length) * 0.34;
      this.ui.setLoading(pct, `Potret ${i + 1} / ${this.characters.length}`);
      if (i % 3 === 0) await nextFrame();
    }

    this.ui.buildCharacterCards(this.characters, this.thumbnails);
    this.ui.setSelectedCharacter(preferred.id);
  }

  _spawnPlayer(characterId) {
    if (this.player) {
      this.scene.remove(this.player.root);
      this.player = null;
    }

    const node = this.assets.getCollectionNode("villagers", characterId);
    if (!node) throw new Error(`Unknown villager ${characterId}`);

    const prototype = this.assets.makePrototype(node, {
      mode: "character",
      targetHeight: 1.72,
      castShadow: true,
      receiveShadow: true,
    });
    this.scene.add(prototype.root);

    const animation = new CharacterAnimation(prototype.root);
    const spawn = {
      x: this.world.spawn.x,
      y: this.world.spawn.y,
      z: this.world.spawn.z,
      heading: Math.PI,
    };
    const controller = new CharacterController({
      model: prototype.root,
      animation,
      collision: this.world.collision,
      spawn,
      radius: 0.38,
      walkSpeed: 5.0,
      runSpeed: 9.4,
    });

    this.player = {
      id: characterId,
      root: prototype.root,
      animation,
      controller,
    };
    this.cameraController.reset(0, 0.36, 7.4);
    this.cameraController.snapTo(controller.position);
  }

  _applyRendererQuality(quality) {
    const ratio =
      quality === "high"
        ? Math.min(window.devicePixelRatio || 1, 2)
        : quality === "medium"
          ? Math.min(window.devicePixelRatio || 1, 1.5)
          : 1;
    this.renderer.setPixelRatio(ratio);
    this.renderer.setSize(window.innerWidth, window.innerHeight);
    if (this.world) this.world.setQuality(quality);
  }

  // --------------------------------------------------------------- UI wiring
  _bindUI() {
    this.ui.setCallbacks({
      play: () => this.play(),
      pause: () => this.pause(),
      resume: () => this.resume(),
      characters: () => this.openCharacterMenu(),
      toMenu: () => this.returnToMenu(),
      settingsChange: (settings) => this.applySettings(settings),
      atlas: () => this.openAtlas(),
      closeAtlas: () => this.closeAtlas(),
      jump: () => {
        if (this.state === "playing") this.jumpQueued = true;
      },
      interact: () => {
        if (this.state === "playing") {
          // Try pickup first
          if (this.player && this.itemPickupManager) {
            const picked = this.itemPickupManager.tryPickup(this.player.controller.position);
            if (picked) return;
          }
          // Check if near trader
          if (this.player && this.npcManager && this.economyManager) {
            const pPos = this.player.controller.position;
            for (const npc of this.npcManager.npcs || []) {
              if (!npc.root || !npc.root.visible) continue;
              if (this.economyManager.isTrader(npc.id)) {
                const dx = npc.root.position.x - pPos.x;
                const dz = npc.root.position.z - pPos.z;
                const dist = Math.hypot(dx, dz);
                if (dist <= 4.0) {
                  const items = this.economyManager.getShopItems(npc.id);
                  this.ui.showShop({ name: npc.name, title: npc.title, id: npc.id }, items, this.economyManager.getMoney());
                  return;
                }
              }
            }
          }
          this._interact();
        }
      },
      dialogueChoice: (choiceId) => {
        this.interactionManager?.handleChoice(choiceId);
      },
      dialogueClose: () => {
        this.interactionManager?.closeDialogue();
      },
      getQuestLog: () => this.questManager?.getQuestLog() || { active: [], completed: [], failed: [] },
      getInventory: () => this.inventoryManager?.getSlots() || Array(24).fill(null),
      inventoryUse: (slotIndex) => {
        const slots = this.inventoryManager?.getSlots() || [];
        const slot = slots[slotIndex];
        if (slot && slot.equipable && this.equipmentManager) {
          const toolMap = { kapak: "axe", beliung: "pickaxe", pedang: "sword" };
          if (toolMap[slot.id]) {
            this.equipmentManager.equip(toolMap[slot.id]);
            const toolNames = { axe: "Kapak", pickaxe: "Beliung", sword: "Pedang" };
            this.ui.setTool?.(`Alat: ${toolNames[toolMap[slot.id]]}`);
            return;
          }
        }
        const result = this.inventoryManager?.useItem(slotIndex);
        if (result && this.ui) this.ui.toast("Item digunakan.");
      },
      inventoryDrop: (slotIndex) => {
        const result = this.inventoryManager?.removeItem(slotIndex, 1);
        if (result && this.ui) this.ui.toast("Item dihapus dari inventaris.");
      },
      getMoney: () => this.economyManager?.getMoney() || 0,
      getShopItems: (npcId) => this.economyManager?.getShopItems(npcId) || [],
      shopBuy: (npcId, itemId, amount) => {
        const res = this.economyManager?.buyItem(npcId, itemId, amount);
        this.ui.setMoney?.(this.economyManager?.getMoney());
        return res;
      },
      shopSell: (npcId, itemId, amount) => {
        const res = this.economyManager?.sellItem(npcId, itemId, amount);
        this.ui.setMoney?.(this.economyManager?.getMoney());
        return res;
      },
      useTool: () => {
        if (this.state === "playing" && this.player && this.resourceManager) {
          const result = this.resourceManager.tryUseResource(this.player.controller.position);
          if (!result && this.equipmentManager?.getCurrentTool() === "sword") {
            this.ui.toast("Tidak ada target untuk diserang.");
          }
        }
      },
      openStrategyMap: () => {
        this.openStrategyMap();
      },
      visitVillage: (village) => {
        this.visitVillage(village);
      },
    });
  }

  _bindWindow() {
    window.addEventListener("resize", () => {
      this.camera.aspect = window.innerWidth / window.innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(window.innerWidth, window.innerHeight);
    });

    window.addEventListener("keydown", (event) => {
      if (isTyping(event.target)) return;

      if (event.code === "Escape") {
        event.preventDefault();
        if (!this.ui.el.strategyScreen?.classList.contains("hidden")) {
          this.ui.hideStrategyMap?.();
        } else if (this.ui.isAtlasOpen()) {
          this.closeAtlas();
        } else if (!this.ui.el.settingsModal?.classList.contains("hidden")) {
          this.ui.openSettings(false);
        } else if (!this.ui.el.helpModal?.classList.contains("hidden")) {
          this.ui.openHelp(false);
        } else if (!this.ui.el.inventoryScreen?.classList.contains("hidden")) {
          this.ui.hideInventory?.();
        } else if (!this.ui.el.questlogScreen?.classList.contains("hidden")) {
          this.ui.hideQuestLog?.();
        } else if (!this.ui.el.dialogScreen?.classList.contains("hidden")) {
          this.ui.hideDialogue?.();
        } else if (!this.ui.el.shopScreen?.classList.contains("hidden")) {
          this.ui.hideShop?.();
        } else if (this.state === "playing") {
          this.pause();
        } else if (this.state === "paused") {
          this.resume();
        }
        return;
      }

      this.keys.add(event.code);
      if (this.state !== "playing") return;

      if (event.code === "Space") {
        event.preventDefault();
        this.jumpQueued = true;
      } else       if (event.code === "KeyE") {
        if (this.state === "playing") {
      if (this.interactionManager?.dialogueState?.open) {
        return;
      }
      if (this.player && this.itemPickupManager) {
        const picked = this.itemPickupManager.tryPickup(this.player.controller.position);
        if (picked) return;
      }
      if (this.player && this.npcManager && this.economyManager) {
        const pPos = this.player.controller.position;
        for (const npc of this.npcManager.npcs || []) {
          if (!npc.root || !npc.root.visible) continue;
          if (this.economyManager.isTrader(npc.id)) {
            const dx = npc.root.position.x - pPos.x;
            const dz = npc.root.position.z - pPos.z;
            const dist = Math.hypot(dx, dz);
            if (dist <= 4.0) {
              const items = this.economyManager.getShopItems(npc.id);
              this.ui.showShop({ name: npc.name, title: npc.title, id: npc.id }, items, this.economyManager.getMoney());
              return;
            }
          }
        }
      }
      if (this.player && this.resourceManager && this.equipmentManager) {
        const used = this.resourceManager.tryUseResource(this.player.controller.position);
        if (used) return;
      } else if (this.player && this.resourceManager) {
        const used = this.resourceManager.tryUseResource(this.player.controller.position);
        if (used) return;
      }
      if (this.interactionManager?.currentTarget) {
        this.interactionManager.interact();
      } else {
        this._interact();
      }
        }
      } else if (event.code === "KeyF") {
        if (this.state === "playing" && this.player && this.resourceManager) {
          this.resourceManager.tryUseResource(this.player.controller.position);
        }
      } else if (event.code === "KeyI") {
        if (this.state === "playing") {
          this.ui.showInventory?.();
        } else if (this.state === "menu") {
          // no
        }
      } else if (event.code === "KeyP") {
        this.pause();
      } else if (
        ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(event.code)
      ) {
        event.preventDefault();
      }
    });

    window.addEventListener("keyup", (event) => {
      this.keys.delete(event.code);
    });

    window.addEventListener("blur", () => {
      this.keys.clear();
      if (this.state === "playing") this.pause();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden && this.state === "playing") this.pause();
    });
  }

  // ---------------------------------------------------------------- commands
  play() {
    document.activeElement?.blur?.();
    const selected = this.ui.getSelectedCharacter();
    if (!this.player || this.player.id !== selected) {
      this._spawnPlayer(selected);
    } else if (this._returnToMenu) {
      this.player.controller.teleport(this.world.spawn.x, this.world.spawn.z, Math.PI);
      this.cameraController.reset(0, 0.36, 7.4);
      this.cameraController.snapTo(this.player.controller.position);
    }

    if (!this.interactionManager && this.player) {
      this.interactionManager = new InteractionManager({
        scene: this.scene,
        camera: this.camera,
        player: this.player,
        npcManager: this.npcManager,
        questManager: this.questManager,
        ui: this.ui
      });
    }

    if (!this.itemPickupManager) {
      this.itemPickupManager = new ItemPickupManager({
        scene: this.scene,
        inventoryManager: this.inventoryManager,
        interactionManager: this.interactionManager,
        ui: this.ui
      });
    }

    if (!this.equipmentManager && this.player) {
      this.equipmentManager = new EquipmentManager({
        scene: this.scene,
        player: this.player,
        inventoryManager: this.inventoryManager,
        ui: this.ui,
        toast: (msg) => this.ui.toast(msg)
      });
    }
    if (!this.resourceManager) {
      this.resourceManager = new ResourceManager({
        scene: this.scene,
        inventoryManager: this.inventoryManager,
        equipmentManager: this.equipmentManager,
        ui: this.ui,
        worldBuilder: this.world
      });
    } else {
      this.resourceManager.equipment = this.equipmentManager;
    }

    this._returnToMenu = false;
    this.player.root.visible = true;
    this.ui.hideMenu();
    this.ui.setPaused(false);
    this.ui.showHUD();
    this.ui.hideDialogue?.();
    this.state = "playing";
    this.ui.toast("Jelajahi Kinstead — geser untuk melihat, WASD untuk bergerak, E untuk berbicara");
  }

  pause() {
    if (this.state !== "playing") return;
    this.state = "paused";
    this._clearInput();
    this.ui.setPaused(true);
  }

  resume() {
    if (this.state !== "paused") return;
    this.state = "playing";
    this.ui.setPaused(false);
  }

  returnToMenu() {
    this._clearInput();
    this.ui.setPaused(false);
    this.ui.showMenu();
    this.ui.hideHUD();
    if (this.player) this.player.root.visible = false;
    this.state = "menu";
    this._returnToMenu = true;
    this._positionCinematic(this.elapsed);
  }

  openCharacterMenu() {
    this._clearInput();
    this.ui.setPaused(false);
    this.ui.showMenu();
    this.ui.hideHUD();
    if (this.player) this.player.root.visible = false;
    this.state = "menu";
    this._returnToMenu = true;
    this._positionCinematic(this.elapsed);
  }

  applySettings(settings) {
    const previousQuality = this.settings.quality;
    this.settings = { ...this.settings, ...settings };
    this.cameraController?.setSensitivity(this.settings.sensitivity);
    this.cameraController?.setInvertY(this.settings.invertY);
    if (this.settings.quality !== previousQuality) {
      this._applyRendererQuality(this.settings.quality);
      this.ui.toast(`Kualitas grafis: ${qualityLabel(this.settings.quality)}`);
    }
  }

  openAtlas() {
    this.stateBeforeAtlas = this.state;
    this.state = "atlas";
    this._clearInput();
    this.ui.openAtlas(true);

    if (!this.atlasData) {
      this.atlasData = this._buildAtlasData();
      this.ui.buildAtlas(this.atlasData);
    }
    this._queueAtlasThumbnails();
  }

  closeAtlas() {
    this.ui.openAtlas(false);
    this.state = this.stateBeforeAtlas === "atlas" ? "menu" : this.stateBeforeAtlas;
    if (this.state === "playing" && this.player) {
      this.cameraController.snapTo(this.player.controller.position);
    }
  }

  openStrategyMap() {
    // Gunakan peta strategi baru bila ModeManager sudah terpasang.
    if (this.modeManager?.switchToStrategy) {
      this.modeManager.switchToStrategy();
      return;
    }
    if (this.state !== "playing" && this.state !== "paused") {
      this.ui.toast("Masuk ke permainan untuk membuka peta desa.");
      return;
    }
    this._clearInput();
    const settlements = SETTLEMENTS || [];
    this.ui.showStrategyMap(settlements);
  }

  async visitVillage(village) {
    this.ui.hideStrategyMap();
    const overlay = document.getElementById("transition-overlay");
    const textEl = document.getElementById("transition-text");
    if (overlay) overlay.classList.remove("hidden");
    if (textEl) textEl.textContent = `Mengunjungi ${village.name}...`;

    await new Promise(r => setTimeout(r, 600));

    // Teleport player to village coordinates
    const groundY = this.world.regionWorld ? this.world.regionWorld.heightAt(village.x, village.z) : 10;
    
    if (this.state !== "playing") {
      const selected = this.ui.getSelectedCharacter();
      this._spawnPlayer(selected);
      this.player.root.visible = true;
      this.ui.hideMenu();
      this.ui.setPaused(false);
      this.ui.showHUD();
      this.state = "playing";
    }

    if (this.player) {
      this.player.controller.teleport(village.x, village.z, Math.PI);
      this.cameraController.reset(0, 0.36, 7.4);
      this.cameraController.snapTo(this.player.controller.position);
    }

    // Warmup region streaming around village
    if (this.world.regionWorld) {
      this.world.regionWorld.warmup(village.x, village.z, 2);
    }

    if (overlay) {
      overlay.classList.add("hidden");
    }
    this.ui.toast(`Selamat datang di ${village.name}!`);
  }

  _buildAtlasData() {
    const categories = this.assets.manifest.categories || {};
    const entries = [];

    const buildingLabels = new Map(
      (categories.buildings?.items || []).map((item) => [item.id, item.label])
    );
    for (const id of this.assets.getBuildingIds()) {
      const node = this.assets.getBuilding(id);
      if (!node) continue;
      entries.push({
        key: "building:" + id,
        label: buildingLabels.get(id) || titleCase(id),
        category: "buildings",
        node,
      });
    }

    for (const category of ["nature", "animals", "decorations"]) {
      for (const entry of this.assets.getCollectionEntries(category)) {
        entries.push({
          key: category + ":" + entry.id,
          label: entry.label || titleCase(entry.id),
          category,
          node: entry.node,
        });
      }
    }

    for (const entry of this.characters) {
      entries.push({
        key: "villager:" + entry.id,
        label: entry.label,
        category: "characters",
        node: entry.node,
      });
    }

    entries.sort((a, b) => {
      const order = {
        buildings: 0,
        characters: 1,
        animals: 2,
        nature: 3,
        decorations: 4,
      };
      if (order[a.category] !== order[b.category]) {
        return order[a.category] - order[b.category];
      }
      return a.label.localeCompare(b.label);
    });
    return entries;
  }

  _queueAtlasThumbnails() {
    if (this.atlasQueue || !this.atlasData) return;
    const pending = this.atlasData.filter((entry) => !entry.thumbnail);
    if (!pending.length) return;
    this.atlasQueue = pending;
    let index = 0;

    const step = () => {
      const start = performance.now();
      while (index < pending.length && performance.now() - start < 20) {
        const entry = pending[index++];
        const data =
          entry.category === "characters"
            ? this.thumbnailer.character(entry.node, entry.key, {
                width: 180,
                height: 220,
              })
            : this.thumbnailer.asset(entry.node, entry.key, {
                width: 180,
                height: 180,
              });
        entry.thumbnail = data;
        this.ui.setAtlasThumbnail(entry.key, data);
      }
      if (index < pending.length) {
        requestAnimationFrame(step);
      } else {
        this.atlasQueue = null;
      }
    };
    requestAnimationFrame(step);
  }

  _interact() {
    if (!this.player) return;
    if (this.interactionManager) {
      if (this.interactionManager.dialogueState?.open) return;
      if (this.interactionManager.currentTarget) {
        this.interactionManager.interact();
        return;
      }
    }
    const playerPos = this.player.controller.position;
    const spoken = this.npcManager?.interactWithNearest(playerPos);
    if (spoken) {
      this.ui.toast(
        `${spoken.name} (${spoken.title}): "${spoken.text}" [Hubungan: ${spoken.friendship}%]`
      );
    } else {
      this.ui.toast("Tidak ada penduduk di dekat sini. Coba hampiri alun-alun atau area kerja.");
    }
  }

  _clearInput() {
    this.keys.clear();
    this.jumpQueued = false;
    this.ui.joystick.x = 0;
    this.ui.joystick.y = 0;
    if (this.player) {
      this.player.controller.input.x = 0;
      this.player.controller.input.y = 0;
      this.player.controller.input.run = false;
    }
  }

  // -------------------------------------------------------------------- loop
  _loop() {
    requestAnimationFrame(() => this._loop());

    // Mode strategi membekukan update dan render dunia 3D. Delta tetap
    // dikonsumsi agar saat kembali ke EXPLORE tidak terjadi lonjakan waktu.
    if (this._renderPaused) {
      this._clock.getDelta();
      return;
    }

    const raw = this._clock.getDelta();
    const dt = Math.min(raw, 0.05);
    this.elapsed += dt;

    this._fpsAccum += raw;
    this._fpsFrames++;
    if (this._fpsAccum >= 0.45) {
      this.fps = this._fpsFrames / this._fpsAccum;
      this.ui.setFps(this.fps);
      this._fpsAccum = 0;
      this._fpsFrames = 0;
    }

    switch (this.state) {
      case "menu":
        this._positionCinematic(this.elapsed);
        this.world.update(dt, this.elapsed, null);
        break;

      case "playing": {
        if (this._modalOpen() || this.ui.el?.dialogScreen && !this.ui.el.dialogScreen.classList.contains("hidden") || this.ui.el?.questlogScreen && !this.ui.el.questlogScreen.classList.contains("hidden")) {
          this._clearInput();
          break;
        }
    this.playTime += dt;
    const input = this.ui.getMoveInput();
    const controller = this.player.controller;
    controller.input.x = input.x;
    controller.input.y = input.y;
    controller.input.run = input.run;
    if (this.jumpQueued) {
      controller.requestJump();
      this.jumpQueued = false;
    }
    controller.update(dt, this.cameraController.yaw);
    this.cameraController.setSprint(controller.running);
    this.cameraController.update(dt, controller.position);
    this.world.update(dt, this.elapsed, controller.position);
    this.npcManager?.update(dt, this.world.dayTime, controller.position);
        this.questManager?.update(controller.position, dt, this.inventoryManager);
        this.interactionManager?.update(dt, controller.position);
        this.itemPickupManager?.update(dt, controller.position);
        if (this.equipmentManager && this.equipmentManager.equipped && !this.equipmentManager.hands?.right) {
          this.equipmentManager.findHandNodes?.();
        }
        if (this.economyManager) {
          this.ui.setMoney?.(this.economyManager.getMoney());
        }
        this.ui.setClock(this.world?.getClockText() || this.playTime);
        break;
      }

      case "paused":
        break;

      case "atlas":
        break;

      default:
        break;
    }

    this.renderer.render(this.scene, this.camera);
  }

  _modalOpen() {
    return (
      !this.ui.el.settingsModal?.classList.contains("hidden") ||
      !this.ui.el.helpModal?.classList.contains("hidden") ||
      !this.ui.el.atlasScreen?.classList.contains("hidden") ||
      !this.ui.el.inventoryScreen?.classList.contains("hidden") ||
      !this.ui.el.questlogScreen?.classList.contains("hidden") ||
      !this.ui.el.dialogScreen?.classList.contains("hidden") ||
      !this.ui.el.shopScreen?.classList.contains("hidden") ||
      !this.ui.el.strategyScreen?.classList.contains("hidden")
    );
  }

  _positionCinematic(time) {
    const center = PLAZA_WORLD;
    const angle = time * 0.055;
    const radius = 74 + Math.sin(time * 0.08) * 10;
    const height = 32 + Math.sin(time * 0.11) * 5;
    const terrainY = this.world?.terrainInfo?.targetHeight;
    const baseY = typeof terrainY === "number" && Number.isFinite(terrainY) ? terrainY : 10;
    this.camera.position.set(
      center.x + Math.cos(angle) * radius,
      baseY + height,
      center.z + Math.sin(angle) * radius
    );
    this.camera.lookAt(
      center.x,
      baseY + 5,
      center.z
    );
  }
}

function nextFrame() {
  return new Promise((resolve) => requestAnimationFrame(() => resolve()));
}

function isTyping(target) {
  if (!target) return false;
  const tag = target.tagName;
  return tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA";
}

function qualityLabel(value) {
  return { high: "Tinggi", medium: "Sedang", low: "Rendah" }[value] || value;
}

function roleLabel(value) {
  const labels = {
    farmer: "petani",
    builder: "pembangun",
    worker: "pekerja",
    fisher: "nelayan",
    shop: "pedagang",
    clerk: "juru tulis",
    teacher: "guru",
    clergy: "pendeta",
    nurse: "perawat",
    watch: "penjaga",
  };
  return labels[value] || "penduduk";
}

function titleCase(value) {
  return String(value || "")
    .replace(/[-_]/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());
}
