export class FloatingActionUI {
  constructor(game) {
    this.game = game;
    this.button = null;
    this.currentTarget = null;
    this.initUI();
    
    // Cek posisi pohon tiap 100ms
    setInterval(() => this.update(), 100);
  }

  initUI() {
    // Bikin tombol HTML melayang
    this.button = document.createElement("button");
    this.button.innerText = "🪓 TEBANG";
    this.button.style.cssText = `
      position: absolute;
      display: none;
      background: #4CAF50;
      color: white;
      border: 2px solid white;
      border-radius: 8px;
      padding: 10px 20px;
      font-weight: bold;
      font-size: 14px;
      z-index: 9999;
      pointer-events: auto;
      box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    `;
    
    // Kalau tombol diklik, panggil sistem nebang
    this.button.onclick = () => {
      if (this.game.harvestSystem) {
        this.game.harvestSystem.interact();
      }
    };
    
    document.body.appendChild(this.button);
  }

  update() {
    const player = this.game.player;
    const tool = this.game.equipmentManager?.getCurrentTool();
    const camera = this.game.camera;
    const renderer = this.game.renderer;
    const resManager = this.game.resourceManager;

    // Sembunyiin tombol kalau nggak megang kapak atau nggak ada data
    if (!player || tool !== "axe" || !camera || !renderer || !resManager || !resManager.resources) {
      this.hide();
      return;
    }

    const px = player.position.x;
    const pz = player.position.z;
    let nearestTree = null;
    let minDist = 4.0; // Jarak maksimal munculnya tombol

    // Cari pohon terdekat
    for (let r of resManager.resources) {
      if (!r || r.chopped) continue;
      const rx = r.mesh ? r.mesh.position.x : (r.position?.x || 0);
      const rz = r.mesh ? r.mesh.position.z : (r.position?.z || 0);
      const dist = Math.sqrt((rx - px) ** 2 + (rz - pz) ** 2);
      
      if (dist < minDist) {
        minDist = dist;
        nearestTree = r;
      }
    }

    if (!nearestTree) {
      this.hide();
      return;
    }

    this.currentTarget = nearestTree;

    // Konversi koordinat 3D pohon ke koordinat Layar HP (2D)
    const treePos = new (window.THREE || {}).Vector3?.() || { 
        x: nearestTree.mesh?.position?.x || 0, 
        y: 0, 
        z: nearestTree.mesh?.position?.z || 0 
    };
    
    // Tambahin ketinggian dikit biar tombolnya di bawah pohon
    if (nearestTree.mesh) treePos.copy(nearestTree.mesh.position).y -= 1.5;

    treePos.project(camera);

    // Hitung posisi X, Y di layar
    const halfWidth = renderer.domElement.clientWidth / 2;
    const halfHeight = renderer.domElement.clientHeight / 2;
    const x = (treePos.x * halfWidth) + halfWidth;
    const y = -(treePos.y * halfHeight) + halfHeight;

    // Tampilkan tombol di posisi tersebut
    this.button.style.display = "block";
    this.button.style.left = `${x}px`;
    this.button.style.top = `${y}px`;
    this.button.style.transform = "translate(-50%, 0)"; // Center tombol
  }

  hide() {
    this.button.style.display = "none";
    this.currentTarget = null;
  }
}
